{
  "name": "campusos",
  "private": true,
  "packageManager": "pnpm@12.12.0",
  "scripts": {
    "dev": "pnpm --filter @campusos/web dev",
    "build": "pnpm --filter @campusos/web build",
    "worker": "pnpm --filter @campusos/worker start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @campusos/db generate",
    "db:migrate": "pnpm --filter @campusos/db migrate",
    "db:seed": "pnpm --filter @campusos/db seed"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.20.5"
  }
}
