# Copy to .env and fill in. Never commit .env.
# Local Postgres (docker compose up -d, or your own server)
DATABASE_URL=postgres://campusos:campusos@localhost:5433/campusos
# Claude API (used from the AI step onward)
ANTHROPIC_API_KEY=

# Random string, at least 16 characters. Used to hash login codes.
AUTH_SECRET=
# 1 = show the login code on screen (only until WhatsApp/SMS delivery is connected). Never in production.
OTP_DEV_SHOW=0
# AI for reading payment screenshots. Free-tier Gemini keys, comma-separated, tried in order (D18).
AI_PROVIDER=gemini
GEMINI_API_KEYS=
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash,gemini-3.5-flash-lite
# simulated = messages are marked as sent automatically (shown in the app, nothing leaves the server)
# manual = staff send each one with a wa.me link. cloud_api = WhatsApp Business API (not built yet)
WHATSAPP_MODE=simulated
# where uploaded screenshots are stored (local disk until R2 is set up)
UPLOAD_DIR=.data/uploads
# 1 = show one-click logins into the synthetic demo school on /login (sales demos). Never on a real school's server.
DEMO_LOGIN=0
